---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.name} — Writer · Director · Animator`,
  description = "Edmond Hawkins is a Brooklyn-based comedy director (HBO, Netflix, NBC, truTV) — directing, writing and visual effects.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "" or "/edmondhawkins.com"
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/img/og.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0c" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- never hide content if JS is unavailable -->
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/img/portrait.jpg`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD: Person -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.name,
        jobTitle: "Director",
        description: description,
        address: { "@type": "PostalAddress", addressLocality: "Brooklyn", addressRegion: "NY" },
        url: Astro.site?.href,
      })}
    />
  </head>
  <body>
    <slot />

    <!-- Global video lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Video player">
      <div class="lightbox__frame">
        <button class="lightbox__close" id="lightbox-close" aria-label="Close video"></button>
        <div id="lightbox-mount"></div>
        <span class="lightbox__title" id="lightbox-title"></span>
      </div>
    </div>

    <script>
      // ---- sticky nav shadow ----
      const nav = document.querySelector(".nav");
      if (nav) {
        const onScroll = () => nav.classList.toggle("is-stuck", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // ---- mobile menu ----
      const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
      toggle?.addEventListener("click", () => {
        const open = nav?.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(!!open));
      });
      document.querySelectorAll(".nav__links a").forEach((a) =>
        a.addEventListener("click", () => {
          nav?.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
        })
      );

      // ---- filters ----
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter");
      const cards = document.querySelectorAll<HTMLElement>(".card[data-cat]");
      const empty = document.querySelector<HTMLElement>(".work-empty");
      function applyFilter(f: string) {
        filterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === f)));
        let shown = 0;
        cards.forEach((c) => {
          const match = f === "all" || c.dataset.cat === f;
          c.classList.toggle("is-hidden", !match);
          if (match) shown++;
        });
        if (empty) empty.style.display = shown ? "none" : "block";
      }
      filterBtns.forEach((btn) => btn.addEventListener("click", () => applyFilter(btn.dataset.filter!)));
      // nav category links: filter the grid, then let the #work anchor scroll
      document.querySelectorAll<HTMLElement>(".nav__links a[data-filter]").forEach((a) =>
        a.addEventListener("click", () => applyFilter(a.dataset.filter!))
      );

      // ---- lightbox ----
      const lb = document.getElementById("lightbox")!;
      const mount = document.getElementById("lightbox-mount")!;
      const lbTitle = document.getElementById("lightbox-title")!;
      const closeBtn = document.getElementById("lightbox-close")!;
      let lastFocus: HTMLElement | null = null;

      const bgRegions = () => document.querySelectorAll(".nav, main, .footer");
      function openVideo(src: string, title: string, trigger?: HTMLElement) {
        lastFocus = trigger ?? null;
        mount.innerHTML = `<iframe src="${src}" title="${title.replace(/"/g, "")}" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>`;
        lbTitle.textContent = title;
        lb.classList.add("is-open");
        document.body.style.overflow = "hidden";
        bgRegions().forEach((el) => el.setAttribute("inert", "")); // trap focus in the dialog
        closeBtn.focus();
      }
      function closeVideo() {
        lb.classList.remove("is-open");
        mount.innerHTML = "";
        document.body.style.overflow = "";
        bgRegions().forEach((el) => el.removeAttribute("inert"));
        lastFocus?.focus();
      }
      document.querySelectorAll<HTMLElement>("[data-embed]").forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          openVideo(el.dataset.embed!, el.dataset.title || "", el);
        });
      });
      closeBtn.addEventListener("click", closeVideo);
      lb.addEventListener("click", (e) => { if (e.target === lb) closeVideo(); });
      window.addEventListener("keydown", (e) => { if (e.key === "Escape" && lb.classList.contains("is-open")) closeVideo(); });

      // ---- contact form: graceful mailto fallback until a real endpoint is set ----
      const form = document.querySelector<HTMLFormElement>(".contact__form");
      if (form && form.dataset.ready !== "true") {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const name = String(data.get("name") || "");
          const email = String(data.get("email") || "");
          const message = String(data.get("message") || "");
          const to = form.dataset.fallbackEmail || "";
          const subject = encodeURIComponent(`Project inquiry from ${name || "the website"}`);
          const body = encodeURIComponent(`${message}\n\n— ${name}\n${email}`);
          window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
        });
      }

      // ---- scroll reveal ----
      // Throttled scroll check (not IntersectionObserver) so it's reliable for very tall
      // elements and never drops fast scrolls — anything reaching the viewport reveals.
      const reveals = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      let ticking = false;
      function reveal() {
        ticking = false;
        const vh = window.innerHeight;
        for (let i = reveals.length - 1; i >= 0; i--) {
          if (reveals[i].getBoundingClientRect().top < vh * 0.92) {
            reveals[i].classList.add("is-in");
            reveals.splice(i, 1);
          }
        }
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(reveal); } }
      reveal();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      window.addEventListener("load", reveal);
    </script>
  </body>
</html>
