---
interface Props {
  items: readonly string[];
  variant?: "net" | "names";
  label?: string;
}
const { items, variant = "net", label } = Astro.props;
---

<div class={`marquee marquee--${variant}`} role="group" aria-label={label}>
  <div class="marquee__track">
    {/* visible + announced once */}
    <div class="marquee__set">
      {items.map((it) => (
        <>
          <span>{it}</span>
          <span class="star" aria-hidden="true">✦</span>
        </>
      ))}
    </div>
    {/* duplicate purely to make the scroll seamless — hidden from assistive tech */}
    <div class="marquee__set" aria-hidden="true">
      {items.map((it) => (
        <>
          <span>{it}</span>
          <span class="star">✦</span>
        </>
      ))}
    </div>
  </div>
</div>
