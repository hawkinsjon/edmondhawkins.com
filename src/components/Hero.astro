---
import { site } from "../data/site";
import { reel, embedUrl } from "../data/work";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const reelTitle = `${site.name}, ${reel.title}`;
---

<section class="hero" id="top">
  <div class="hero__glow"></div>
  <div class="hero__grid"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">{site.role}</span>

      <h1 class="hero__name">
        <span>Edmond</span>
        <span class="ink-accent">Hawkins</span>
      </h1>

      <p class="hero__tag">{site.tagline}</p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#" data-embed={embedUrl(reel)} data-title={reelTitle}>
          <span class="play-tri"></span> Watch the Reel
        </a>
        <a class="btn btn--ghost" href="#work">See the Work</a>
      </div>

      <ul class="hero__credits">
        {site.heroCredits.map((c) => (
          <li>
            <span class="net">{c.network}</span>
            <span class="show">{c.show}</span>
          </li>
        ))}
      </ul>
    </div>

    <button class="hero__reel" data-embed={embedUrl(reel)} data-title={reelTitle} aria-label="Play directing reel">
      <img src={`${base}/img/reel-poster.jpg`} alt="Edmond Hawkins, director" loading="eager" width="640" height="360" />
      <span class="hero__reel-shade"></span>
      <span class="card__play"><i></i></span>
      <span class="card__badge" style="z-index:4;">▶ Directing Reel</span>
    </button>
  </div>
</section>
