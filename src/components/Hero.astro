---
import { site } from "../data/site";
import { reel, embedUrl, thumb, stats } from "../data/work";
---

<section class="hero" id="top">
  <div class="hero__glow"></div>
  <div class="hero__grid"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">{site.roles.join(" · ")}</span>

      <h1 class="hero__name">
        <span>Edmond</span>
        <span class="ink-accent">Hawkins</span>
      </h1>

      <p class="hero__tag">{site.tagline}</p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#" data-embed={embedUrl(reel)} data-title={`${site.name} — ${reel.title}`}>
          <span class="play-tri"></span> Watch the Reel
        </a>
        <a class="btn btn--ghost" href="#work">See the Work</a>
      </div>

      <div class="hero__stats">
        <div class="hero__stat"><div class="n">{stats.videos}+</div><div class="l">Films &amp; Clips</div></div>
        <div class="hero__stat"><div class="n">{stats.shows}</div><div class="l">Shows &amp; Series</div></div>
        <div class="hero__stat"><div class="n">{stats.networks}</div><div class="l">Networks</div></div>
      </div>
    </div>

    <button
      class="hero__reel"
      data-embed={embedUrl(reel)}
      data-title={`${site.name} — ${reel.title}`}
      aria-label="Play directing reel"
    >
      <img src={thumb(reel)} alt="Edmond Hawkins directing reel" loading="eager" width="640" height="400" style="width:100%;height:100%;object-fit:cover;" />
      <span class="hero__reel-shade"></span>
      <span class="card__play"><i></i></span>
      <span class="card__badge" style="z-index:4;">▶ Directing Reel</span>
    </button>
  </div>
</section>
